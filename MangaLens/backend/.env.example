# 复制为 .env 后填写。不填任何 Key 也能运行（自动使用 mock provider）

# mock | openai
VISION_PROVIDER=mock

# OpenAI 兼容网关（agnes 等）
# 同款见 AIRoomBuilder/backend/.env.example 第10-15行
OPENAI_API_KEY=
OPENAI_BASE_URL=https://apihub.agnes-ai.cn/v1
OPENAI_MODEL=agnes-2.0-flash

# 是否缓存模型结果（开发期强烈建议开启，省钱且结果可复现）
VISION_CACHE_ENABLED=true

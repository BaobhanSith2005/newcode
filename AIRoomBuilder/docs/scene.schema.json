{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-room-builder.local/scene.schema.json",
  "title": "AI Room Builder Scene",
  "type": "object",
  "required": ["schema_version", "room", "objects"],
  "properties": {
    "schema_version": { "type": "string", "pattern": "^\\d+\\.\\d+$" },
    "scene_id": { "type": "string" },
    "room": {
      "type": "object",
      "required": ["type", "width", "depth", "height"],
      "properties": {
        "type": { "type": "string" },
        "width": { "type": "number", "minimum": 1, "maximum": 30 },
        "depth": { "type": "number", "minimum": 1, "maximum": 30 },
        "height": { "type": "number", "minimum": 2, "maximum": 6 },
        "floor": { "$ref": "#/$defs/surface" },
        "wall": { "$ref": "#/$defs/surface" },
        "ceiling": { "$ref": "#/$defs/surface" }
      }
    },
    "openings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "wall", "offset", "width", "height"],
        "properties": {
          "id": { "type": "string" },
          "type": { "enum": ["window", "door"] },
          "wall": { "$ref": "#/$defs/wall" },
          "offset": { "type": "number", "minimum": 0, "maximum": 1 },
          "width": { "type": "number", "exclusiveMinimum": 0 },
          "height": { "type": "number", "exclusiveMinimum": 0 },
          "sill": { "type": "number", "minimum": 0 }
        }
      }
    },
    "objects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "category", "size", "position", "rotation_y"],
        "properties": {
          "id": { "type": "string" },
          "category": { "type": "string" },
          "label": { "type": "string" },
          "asset": {
            "type": "object",
            "properties": {
              "kind": { "enum": ["gltf", "primitive"] },
              "url": { "type": ["string", "null"] },
              "fallback": { "type": "string" }
            }
          },
          "size": {
            "type": "object",
            "required": ["w", "d", "h"],
            "properties": {
              "w": { "type": "number", "exclusiveMinimum": 0 },
              "d": { "type": "number", "exclusiveMinimum": 0 },
              "h": { "type": "number", "exclusiveMinimum": 0 }
            }
          },
          "position": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": { "type": "number" }
          },
          "rotation_y": { "type": "number" },
          "against_wall": { "oneOf": [{ "$ref": "#/$defs/wall" }, { "type": "null" }] },
          "material": {
            "type": "object",
            "properties": {
              "color": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
              "name": { "type": "string" }
            }
          },
          "color": { "type": "string" },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "source": { "enum": ["vlm", "user", "solver"] }
        }
      }
    },
    "lighting": {
      "type": "object",
      "properties": {
        "preset": { "enum": ["daylight", "evening", "neutral"] },
        "ambient_intensity": { "type": "number", "minimum": 0 },
        "main_intensity": { "type": "number", "minimum": 0 }
      }
    },
    "meta": { "type": "object" }
  },
  "$defs": {
    "wall": { "enum": ["north", "south", "east", "west", "center"] },
    "surface": {
      "type": "object",
      "properties": {
        "material": { "type": "string" },
        "color": { "type": "string" }
      }
    }
  }
}

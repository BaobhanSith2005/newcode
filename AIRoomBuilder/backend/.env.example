# 复制为 .env 后填写。不填任何 Key 也能运行（自动使用 mock provider）

# mock | dashscope | openai | gemini
VISION_PROVIDER=mock

# 阿里云百炼（Qwen-VL）
DASHSCOPE_API_KEY=
DASHSCOPE_MODEL=qwen-vl-max-latest

# OpenAI 兼容（GPT-4o / 其他兼容网关）
# 任意 OpenAI 兼容网关都复用本段：改 OPENAI_BASE_URL 指向你的 /v1 端点、OPENAI_MODEL 填模型名即可。
# 例：ibilieve 自建网关 -> OPENAI_BASE_URL=https://ai.ibilieve.com/v1  OPENAI_MODEL=agnes-2.0-flash
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=agnes-2.0-flash

# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# 是否缓存 VLM 结果（开发期强烈建议开启，省钱且结果可复现）
VISION_CACHE_ENABLED=true
